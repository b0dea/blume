---
interface Props {
  method: string;
  class?: string;
}

const { method, class: className } = Astro.props;
const upper = method.toUpperCase();

// A badge draws its label over a tint of its own hue, so the light value has to
// be dark enough to clear 4.5:1 against that tint — the WCAG AA bar for text
// this size. `-700` is dark enough for most hues (POST 5.71:1, DELETE 5.17:1),
// but not for green and orange: GET and PUT measured 4.32:1 and 4.44:1, so they
// take `-800` (6.20:1 and 6.25:1) the way PATCH already does. Dark mode clears
// the bar at `-300` throughout (9.69:1 and up), so only the light values differ.
const COLORS: Record<string, string> = {
  DELETE: "bg-red-500/15 text-red-700 dark:text-red-300",
  GET: "bg-green-500/15 text-green-800 dark:text-green-300",
  HEAD: "bg-muted text-muted-foreground",
  OPTIONS: "bg-muted text-muted-foreground",
  PATCH: "bg-yellow-500/20 text-yellow-800 dark:text-yellow-300",
  POST: "bg-blue-500/15 text-blue-700 dark:text-blue-300",
  PUT: "bg-orange-500/15 text-orange-800 dark:text-orange-300",
  // AsyncAPI actions.
  RECEIVE: "bg-teal-500/15 text-teal-700 dark:text-teal-300",
  SEND: "bg-violet-500/15 text-violet-700 dark:text-violet-300",
  // GraphQL root-field kinds (type-page kinds fall through to the muted
  // default, so operation badges stay the loud ones).
  MUTATION: "bg-blue-500/15 text-blue-700 dark:text-blue-300",
  QUERY: "bg-green-500/15 text-green-800 dark:text-green-300",
  SUBSCRIPTION: "bg-violet-500/15 text-violet-700 dark:text-violet-300",
};
const color = COLORS[upper] ?? "bg-muted text-muted-foreground";
---

<span
  class:list={[
    "not-prose inline-flex items-center rounded-md px-2 py-0.5 font-mono font-semibold text-xs uppercase tracking-wide",
    color,
    className,
  ]}>{upper}</span
>
