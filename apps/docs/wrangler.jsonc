{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blume-docs",
  "compatibility_date": "2026-09-01",
  // Production hostname, attached as a Workers custom domain (DNS record and
  // certificate are managed by Cloudflare). Other hostnames redirect here via
  // zone Redirect Rules.
  "routes": [{ "pattern": "useblume.dev", "custom_domain": true }],
  // Node built-ins for the MCP server and the Astro runtime.
  "compatibility_flags": ["nodejs_compat"],
  // @astrojs/cloudflare fills in `main` and `assets.directory` when it writes
  // dist/server/wrangler.json; declaring the binding here keeps the adapter
  // from replacing this block.
  "assets": {
    "binding": "ASSETS",
    // Blume prerenders directory-style pages (/docs/usage/index.html) and links
    // to them without a trailing slash; the default auto-trailing-slash mode
    // would 307 every page to /docs/usage/. Drop it to keep the canonical URLs.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // With a 404 page configured the static layer answers every request that
    // has no matching asset itself (a POST gets a bare 405), so the server
    // endpoints must be routed to the Worker explicitly. Blume merges its own
    // content-route rules into this list at build time.
    "run_worker_first": ["/mcp"],
  },
  "observability": {
    "enabled": true,
  },
}
