---
// The featured guide at the top of /guides: the grid item's parts at a larger
// size, side by side. On the grid below's three columns, so its edges line up
// with the items under it: the title, summary, and author in the first
// column, the cover across the other two. Below `lg` the cover leads. The
// title is the link, stretched over the whole item.
import GuideCover from "./GuideCover.astro";
import { authors, type Guide } from "./guides.ts";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const author = authors[guide.author];
---

<article
  class="group relative grid items-center gap-x-4 gap-y-8 lg:grid-cols-3"
>
  <div class="flex flex-col items-start gap-4 lg:pr-8">
    <h2 class="text-balance font-medium text-3xl text-foreground sm:text-4xl">
      <a class="after:absolute after:inset-0" href={`/guides/${guide.id}`}>
        {guide.title}
      </a>
    </h2>
    <p class="max-w-[48ch] text-pretty text-lg text-muted-foreground">
      {guide.summary}
    </p>
    <div class="flex items-center gap-3 text-sm">
      {
        author.avatar && (
          <img
            alt=""
            class="size-8 shrink-0 rounded-full object-cover outline-1 -outline-offset-1 outline-foreground/10"
            decoding="async"
            height="32"
            src={author.avatar}
            width="32"
          />
        )
      }
      <p class="text-muted-foreground">
        By <span class="text-foreground">{author.name}</span>
      </p>
    </div>
  </div>
  <GuideCover
    class="aspect-[16/10] max-lg:order-first lg:col-span-2"
    guide={guide}
    loading="eager"
  />
</article>
