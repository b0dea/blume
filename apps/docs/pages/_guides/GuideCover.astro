---
// A guide's cover: its `image` when it has one, cropped to fill the frame;
// until then a placeholder on the homepage trays' bloom surface (the pale
// cornflower wash over the hex dot lattice, see Tray.astro) with the guide's
// topic glyph at its center. The frame is the page's 28px surface with a
// hairline edge drawn over the art; it's a grid so the placeholder (which the
// tray makes `relative`) stretches to fill it. Decorative on the cards, where
// the title beside or beneath it names the guide. The art drifts a little
// closer while the card around it (`group`) is hovered.
import Tray from "../_home/Tray.astro";
import { glyph } from "../_home/shared.ts";
import { type Guide, topics } from "./guides.ts";

interface Props {
  class?: string;
  guide: Guide;
  /** `eager` for a cover above the fold, like the featured guide's. */
  loading?: "eager" | "lazy";
}

const { class: className, guide, loading = "lazy" } = Astro.props;
---

<div
  class:list={[
    "guide-cover relative isolate grid overflow-hidden rounded-[28px] outline-1 -outline-offset-1 outline-foreground/5",
    className,
  ]}
>
  {
    guide.image ? (
      <img
        alt=""
        class="guide-cover-art absolute inset-0 size-full object-cover"
        decoding="async"
        loading={loading}
        src={guide.image.src}
      />
    ) : (
      <Tray
        class="guide-cover-art flex items-center justify-center"
        tone="bloom"
      >
        <svg
          aria-hidden="true"
          class="size-12 shrink-0 text-accent"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
          set:html={glyph(topics[guide.topic].icon)}
        />
      </Tray>
    )
  }
</div>

<style>
  /* The tray renders the placeholder's element, so reach it globally. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .guide-cover :global(.guide-cover-art) {
      transition: scale 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    :global(.group:hover) .guide-cover :global(.guide-cover-art) {
      scale: 1.03;
    }
  }
</style>
