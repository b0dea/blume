---
// The guides index (/guides): a left-aligned two-tone heading, the newest
// guide featured large (_guides/GuideFeature.astro), then every other guide in
// the grid beneath it, then the install CTA. guides.ts lists guides newest
// first, so a new guide at the top of that list takes the featured spot. The
// list is also emitted as schema.org ItemList structured data, so search and
// answer engines read it as a collection of the guides it links to.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import GuideFeature from "../_guides/GuideFeature.astro";
import GuideGrid from "../_guides/GuideGrid.astro";
import { guides } from "../_guides/guides.ts";
import Footer from "../_home/Footer.astro";
import InstallCta from "../_home/InstallCta.astro";
import Motion from "../_home/Motion.astro";
import { installCopyScript } from "../_home/shared.ts";

const { config } = data;
const pageTitle = "Blume guides";
const pageDescription =
  "Step-by-step guides to getting things done with Blume, from deploying your docs to opening them up to AI agents.";
const [featured, ...rest] = guides;
const itemList = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: guides.map((guide, index) => ({
    "@type": "ListItem",
    name: guide.title,
    position: index + 1,
    url: config.site
      ? new URL(`/guides/${guide.id}`, config.site).href
      : `/guides/${guide.id}`,
  })),
  name: pageTitle,
}).replaceAll("<", "\\u003c");
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/guides", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <section class="flex flex-col gap-12 pt-16 sm:pt-24 lg:gap-16">
      <h1 class="max-w-[30ch] text-balance font-medium text-4xl sm:text-5xl">
        <span class="block">Guides.</span>
        <span class="block text-muted-foreground">One goal at a time.</span>
      </h1>

      {featured && <GuideFeature guide={featured} />}

      {
        rest.length > 0 && (
          <div
            class="border-border border-t pt-12 lg:pt-16"
            data-reveal
          >
            <GuideGrid guides={rest} level="h2" />
          </div>
        )
      }
    </section>

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  {
    config.structuredData && (
      <script is:inline set:html={itemList} type="application/ld+json" />
    )
  }
  <Footer slot="footer" />
</PageLayout>
